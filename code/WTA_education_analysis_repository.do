* Subset to keep consistent sample for all models

*******************************************************
* 2. Define model specifications
*******************************************************
local model1 "WTA WTP_log"
local model2 "WTA WTP_log i.DBegFarm avgknowledge_be avgknowledge_af"
local model3 "WTA WTP_log i.DBegFarm avgknowledge_be avgknowledge_af total_travelcost "
local model4 "WTA WTP_log i.DBegFarm avgknowledge_be avgknowledge_af edu_yrs i.d_male age_num"
local model5 "WTA WTP_log i.DBegFarm avgknowledge_be avgknowledge_af total_travelcost edu_yrs i.d_male age_num"

*******************************************************
* 3. OLS regressions (Linear models)
*******************************************************
* Model 1: OLS
regress `model1', robust
eststo lin_m1
outreg2 using "Linear_Full_WTA_3rd_Wage_combined.doc", replace ctitle(WTA)
* Store Adjusted R^2, then generate residuals and test normality
estadd scalar adj_r2 = e(r2_a)
predict lin_m1_resid, resid
swilk lin_m1_resid  // Tests normality of OLS residuals


* Model 2: OLS
regress `model2', robust
eststo lin_m2
outreg2 using "Linear_Full_WTA_3rd_Wage_combined.doc", append ctitle(WTA)

estadd scalar adj_r2 = e(r2_a)
predict lin_m2_resid, resid
swilk lin_m2_resid

* Model 3: OLS
regress `model3', robust
