estadd scalar adj_r2 = e(r2_a)
predict lin_m5_resid, resid
swilk lin_m5_resid


esttab lin_m1 lin_m2 lin_m3 lin_m4 lin_m5, stats(adj_r2 aic bic ll) label
        
